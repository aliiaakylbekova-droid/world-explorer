{
  "name": "geo-quest",
  "private": true,
  "version": "1.0.0",
  "description": "GEO QUEST — Explore the World. Discover the Unknown.",
  "author": "Aliia",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-browser.cjs",
    "electron:dev": "node scripts/dev.cjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.181.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.geoquest.desktop",
    "productName": "GEO QUEST",
    "copyright": "Copyright © Aliia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable.${ext}"
    },
    "zip": {
      "artifactName": "${productName} Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "GEO QUEST",
      "uninstallDisplayName": "GEO QUEST",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "artifactName": "${productName} Setup.${ext}"
    }
  }
}
